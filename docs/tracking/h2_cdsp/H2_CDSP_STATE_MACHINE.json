{
  "schema_version": "tracking.h2_cdsp_state_machine.v1",
  "hypothesis": "H2_CAUSAL_DROPOUT_STATE_PRESERVATION",
  "states": [
    {
      "name": "VISIBLE_CONFIRMED",
      "maximum_duration_frames": null,
      "association_evidence_usable": false,
      "h2_may_emit_track": false,
      "meaning": "Ordinary baseline has a current trusted detector match."
    },
    {
      "name": "DROPOUT_GRACE",
      "maximum_duration_frames": 2,
      "association_evidence_usable": true,
      "h2_may_emit_track": false,
      "meaning": "One or two causal frames since trusted detection."
    },
    {
      "name": "OCCLUSION_PRESERVED",
      "maximum_duration_frames": 6,
      "association_evidence_usable": true,
      "h2_may_emit_track": false,
      "meaning": "Bounded dropout with causal baseline occlusion support."
    },
    {
      "name": "STALE_PRESERVED",
      "maximum_duration_frames": 10,
      "association_evidence_usable": "only_when_formula_usable_is_true",
      "h2_may_emit_track": false,
      "meaning": "State remains bounded but is old or weak."
    },
    {
      "name": "INVALIDATED",
      "maximum_duration_frames": null,
      "association_evidence_usable": false,
      "h2_may_emit_track": false,
      "meaning": "H2 evidence is unavailable; baseline lifecycle remains sovereign."
    },
    {
      "name": "TERMINATED",
      "maximum_duration_frames": null,
      "association_evidence_usable": false,
      "h2_may_emit_track": false,
      "meaning": "Absorbing state for the terminated baseline track."
    }
  ],
  "baseline_lifecycle_mapping": {
    "live_track": "fixed_id is present in the active baseline track dictionary",
    "trusted_match": "FixedTrack.state is VISIBLE; last_source is detected; last_ambiguous is false; hits >= 4; baseline accepted one unique current-frame detection with confidence >= effective realtime_fast track_high_conf; bbox is finite and positive-area",
    "VISIBLE_CONFIRMED": "live_track and trusted_match",
    "DROPOUT_GRACE": "live_track; FixedTrack.state in {MISSING,OCCLUDED}; dropout_age in {1,2}",
    "OCCLUSION_PRESERVED": "live_track; FixedTrack.state is OCCLUDED; dropout_age in [3,6]; and one causal flag is true: last_source is occlusion_hold, is_area_occluded, or last_merged_split",
    "STALE_PRESERVED": "live_track and either dropout_age in [3,10] without qualifying occlusion support or dropout_age in [7,10]",
    "INVALIDATED": "H2 evidence disabled while baseline track may remain present; FixedTrack.state LOST routes here and does not imply termination",
    "TERMINATED": "fixed_id removed from active baseline track dictionary or explicitly removed by baseline lifecycle",
    "sequence_reset": "opaque sequence boundary token changes before any new-frame state is consumed"
  },
  "transition_precedence": [
    "T13_TERMINAL_ABSORBING when source is TERMINATED",
    "T11_SEQUENCE_BOUNDARY_CLEARS",
    "T12_BASELINE_TERMINATES",
    "T09_INVALIDATED_BASELINE_REACQUIRE when source is INVALIDATED and ordinary trusted match is present",
    "T10_FAIL_CLOSED_INVALIDATION for any remaining invalid or unsafe source",
    "T01_TRUSTED_MATCH_INITIALIZES for a non-invalidated source",
    "one deterministic age-and-occlusion route among T02 through T07",
    "otherwise T10_FAIL_CLOSED_INVALIDATION"
  ],
  "non_transition_invariants": {
    "weak_ambiguous_or_unassigned_detection": "never refreshes snapshot, appearance, motion, confidence, or uncertainty",
    "baseline_lost_is_not_termination": true,
    "occlusion_support_adds_confidence": false
  },
  "transitions": [
    {
      "transition_id": "T01_TRUSTED_MATCH_INITIALIZES",
      "from": ["VISIBLE_CONFIRMED", "DROPOUT_GRACE", "OCCLUSION_PRESERVED", "STALE_PRESERVED"],
      "to": "VISIBLE_CONFIRMED",
      "causal_trigger": "ordinary baseline independently accepts a trusted current-frame detector match",
      "required_evidence": ["FixedTrack.state VISIBLE", "last_source detected", "last_ambiguous false", "hits at least 4", "unique accepted detection at effective track_high_conf or above", "finite positive-area bbox"],
      "maximum_duration_frames": 0,
      "state_confidence_update": "set C0=1",
      "uncertainty_update": "set U0=0.10",
      "appearance_handling": "may refresh only from the assigned detection",
      "motion_handling": "may refresh from ordered trusted geometry",
      "association_evidence_usable": false,
      "h2_may_emit_track": false,
      "invalidation_condition": "any trusted-match requirement fails"
    },
    {
      "transition_id": "T02_VISIBLE_TO_GRACE",
      "from": ["VISIBLE_CONFIRMED"],
      "to": "DROPOUT_GRACE",
      "causal_trigger": "next causal frame has no ordinary trusted detector match",
      "required_evidence": ["valid trusted snapshot", "same sequence", "continuous frame index"],
      "maximum_duration_frames": 2,
      "state_confidence_update": "C(age)=C0*2^(-age/6)",
      "uncertainty_update": "U(age) frozen formula",
      "appearance_handling": "preserve without refresh; reliability decays",
      "motion_handling": "propagate if valid; otherwise hold geometry",
      "association_evidence_usable": "formula gated",
      "h2_may_emit_track": false,
      "invalidation_condition": "core invalid or formula unusable"
    },
    {
      "transition_id": "T03_GRACE_CONTINUES",
      "from": ["DROPOUT_GRACE"],
      "to": "DROPOUT_GRACE",
      "causal_trigger": "no trusted match and dropout age remains at most 2",
      "required_evidence": ["same sequence", "continuous frame index", "usable formula"],
      "maximum_duration_frames": 2,
      "state_confidence_update": "monotonic frozen decay",
      "uncertainty_update": "monotonic frozen growth",
      "appearance_handling": "no refresh; decay",
      "motion_handling": "causal propagation only",
      "association_evidence_usable": true,
      "h2_may_emit_track": false,
      "invalidation_condition": "age above 2 routes to T04 or T05; unsafe routes T10"
    },
    {
      "transition_id": "T04_GRACE_TO_OCCLUSION",
      "from": ["DROPOUT_GRACE"],
      "to": "OCCLUSION_PRESERVED",
      "causal_trigger": "dropout age 3 through 6 and causal baseline occlusion estimate is present",
      "required_evidence": ["usable formula", "occlusion estimate from current or past state"],
      "maximum_duration_frames": 6,
      "state_confidence_update": "monotonic frozen decay; occlusion adds no confidence",
      "uncertainty_update": "monotonic frozen growth",
      "appearance_handling": "no refresh; decay",
      "motion_handling": "causal propagation only",
      "association_evidence_usable": true,
      "h2_may_emit_track": false,
      "invalidation_condition": "unsafe formula routes T10"
    },
    {
      "transition_id": "T05_GRACE_TO_STALE",
      "from": ["DROPOUT_GRACE"],
      "to": "STALE_PRESERVED",
      "causal_trigger": "dropout age at least 3 without causal occlusion support",
      "required_evidence": ["usable formula", "same sequence", "continuous frame index"],
      "maximum_duration_frames": 10,
      "state_confidence_update": "monotonic frozen decay",
      "uncertainty_update": "monotonic frozen growth",
      "appearance_handling": "no refresh; decay",
      "motion_handling": "causal propagation or hold",
      "association_evidence_usable": "formula gated",
      "h2_may_emit_track": false,
      "invalidation_condition": "unsafe formula routes T10"
    },
    {
      "transition_id": "T06_OCCLUSION_CONTINUES",
      "from": ["OCCLUSION_PRESERVED"],
      "to": "OCCLUSION_PRESERVED",
      "causal_trigger": "occlusion support persists and age remains at most 6",
      "required_evidence": ["usable formula", "causal occlusion estimate"],
      "maximum_duration_frames": 6,
      "state_confidence_update": "monotonic frozen decay",
      "uncertainty_update": "monotonic frozen growth",
      "appearance_handling": "no refresh; decay",
      "motion_handling": "causal propagation only",
      "association_evidence_usable": true,
      "h2_may_emit_track": false,
      "invalidation_condition": "unsafe formula routes T10"
    },
    {
      "transition_id": "T07_OCCLUSION_TO_STALE",
      "from": ["OCCLUSION_PRESERVED"],
      "to": "STALE_PRESERVED",
      "causal_trigger": "dropout age reaches 7 or occlusion support ends",
      "required_evidence": ["usable formula", "same sequence", "continuous frame index"],
      "maximum_duration_frames": 10,
      "state_confidence_update": "monotonic frozen decay",
      "uncertainty_update": "monotonic frozen growth",
      "appearance_handling": "no refresh; decay",
      "motion_handling": "causal propagation or hold",
      "association_evidence_usable": "formula gated",
      "h2_may_emit_track": false,
      "invalidation_condition": "unsafe formula routes T10"
    },
    {
      "transition_id": "T08_STALE_CONTINUES",
      "from": ["STALE_PRESERVED"],
      "to": "STALE_PRESERVED",
      "causal_trigger": "no trusted match and dropout age remains between 3 and 10",
      "required_evidence": ["usable formula", "same sequence", "continuous frame index"],
      "maximum_duration_frames": 10,
      "state_confidence_update": "monotonic frozen decay",
      "uncertainty_update": "monotonic frozen growth",
      "appearance_handling": "no refresh; decay",
      "motion_handling": "causal propagation or hold",
      "association_evidence_usable": "formula gated",
      "h2_may_emit_track": false,
      "invalidation_condition": "unsafe formula routes T10"
    },
    {
      "transition_id": "T09_INVALIDATED_BASELINE_REACQUIRE",
      "from": ["INVALIDATED"],
      "to": "VISIBLE_CONFIRMED",
      "causal_trigger": "ordinary baseline matches the same still-live track without H2 evidence",
      "required_evidence": ["all T01 trusted-match requirements", "baseline track not terminated"],
      "maximum_duration_frames": 0,
      "state_confidence_update": "new snapshot C0=1",
      "uncertainty_update": "set new U0=0.10",
      "appearance_handling": "new assigned detection may initialize prototype",
      "motion_handling": "new ordered trusted history may initialize motion",
      "association_evidence_usable": false,
      "h2_may_emit_track": false,
      "invalidation_condition": "ordinary trusted match absent"
    },
    {
      "transition_id": "T10_FAIL_CLOSED_INVALIDATION",
      "from": ["VISIBLE_CONFIRMED", "DROPOUT_GRACE", "OCCLUSION_PRESERVED", "STALE_PRESERVED", "INVALIDATED"],
      "to": "INVALIDATED",
      "causal_trigger": "core invalid, nonfinite, age above 10, confidence below 0.30, uncertainty above 0.75, or continuity broken",
      "required_evidence": ["one invalidation condition"],
      "maximum_duration_frames": 0,
      "state_confidence_update": "evidence disabled",
      "uncertainty_update": "set diagnostic uncertainty to 1",
      "appearance_handling": "unavailable",
      "motion_handling": "unavailable",
      "association_evidence_usable": false,
      "h2_may_emit_track": false,
      "invalidation_condition": "already satisfied"
    },
    {
      "transition_id": "T11_SEQUENCE_BOUNDARY_CLEARS",
      "from": ["VISIBLE_CONFIRMED", "DROPOUT_GRACE", "OCCLUSION_PRESERVED", "STALE_PRESERVED", "INVALIDATED"],
      "to": "INVALIDATED",
      "causal_trigger": "opaque sequence boundary token changes",
      "required_evidence": ["runner lifecycle boundary"],
      "maximum_duration_frames": 0,
      "state_confidence_update": "clear",
      "uncertainty_update": "clear",
      "appearance_handling": "clear",
      "motion_handling": "clear",
      "association_evidence_usable": false,
      "h2_may_emit_track": false,
      "invalidation_condition": "cross-sequence transfer forbidden"
    },
    {
      "transition_id": "T12_BASELINE_TERMINATES",
      "from": ["VISIBLE_CONFIRMED", "DROPOUT_GRACE", "OCCLUSION_PRESERVED", "STALE_PRESERVED", "INVALIDATED"],
      "to": "TERMINATED",
      "causal_trigger": "ordinary baseline terminates the track",
      "required_evidence": ["baseline lifecycle termination"],
      "maximum_duration_frames": 0,
      "state_confidence_update": "clear",
      "uncertainty_update": "clear",
      "appearance_handling": "clear",
      "motion_handling": "clear",
      "association_evidence_usable": false,
      "h2_may_emit_track": false,
      "invalidation_condition": "terminal is absorbing"
    },
    {
      "transition_id": "T13_TERMINAL_ABSORBING",
      "from": ["TERMINATED"],
      "to": "TERMINATED",
      "causal_trigger": "any later frame or candidate",
      "required_evidence": [],
      "maximum_duration_frames": null,
      "state_confidence_update": "none",
      "uncertainty_update": "none",
      "appearance_handling": "none",
      "motion_handling": "none",
      "association_evidence_usable": false,
      "h2_may_emit_track": false,
      "invalidation_condition": "a new object must receive a distinct baseline track"
    }
  ],
  "global_invariants": {
    "reserves_detection": false,
    "directly_assigns_detection": false,
    "blocks_visible_assignment": false,
    "creates_track": false,
    "adds_emission": false,
    "future_frames_used": false,
    "output_delay_frames": 0,
    "gt_runtime_input": false,
    "video_or_episode_shortcut": false,
    "telemetry_required_for_algorithm": false
  },
  "association_consumer_contract": {
    "record_type": "PreservedStateEvidence",
    "sole_permitted_use": "one-for-one substitution for an absent or baseline-degraded bbox, motion reference, or appearance reference of the same still-live track",
    "candidate_set_unchanged": true,
    "ordinary_costs_weights_gates_solver_unchanged": true,
    "new_pair_penalty_or_bonus": false,
    "owner_preference_score": false,
    "detection_reservation": false,
    "candidate_removal": false,
    "visible_assignment_veto": false,
    "direct_assignment": false,
    "maximum_influence": "no more than the unchanged ordinary association influence of the substituted track-local evidence channel",
