  "score": {
    "hidden_quality_formula": "Q(h,d)=0.250*overlap_similarity+0.200*normalized_center_similarity+0.100*scale_similarity+0.200*appearance_similarity+0.100*motion_consistency+0.100*track_freshness+0.025*appearance_available+0.025*motion_available",
    "visible_quality_formula": "Q(v,d)=0.250*overlap_similarity+0.200*normalized_center_similarity+0.100*scale_similarity+0.200*appearance_similarity+0.100*motion_consistency+0.100*track_freshness+0.025*appearance_available+0.025*motion_available",
    "formula": "clip(0.5+0.5*(Q(h,d)-Q(v,d)),0,1)",
    "range": [0.0, 1.0],
    "weights": {
      "overlap_similarity": 0.25,
      "normalized_center_similarity": 0.2,
      "scale_similarity": 0.1,
      "appearance_similarity": 0.2,
      "motion_consistency": 0.1,
      "track_freshness": 0.1,
      "appearance_available": 0.025,
      "motion_available": 0.025
    },
    "missingness_behavior": {
      "appearance": "quality=0.5 and availability=0 for either candidate under the same rule",
      "motion": "quality=0.5 and availability=0 for either candidate under the same rule",
      "mandatory_geometry": "abstain when invalid or unavailable",
      "detection_confidence": "abstain when missing or non-finite"
    }
  },
  "frozen_activation_gate": {
    "activation_threshold": 0.6,
    "score_comparison": "owner_preference_score >= activation_threshold",
    "minimum_hidden_quality_margin_over_visible": 0.2,
    "margin_equivalence": "score>=0.60 is equivalent to Q(h,d)-Q(v,d)>=0.20 before clipping",
    "minimum_detection_confidence": 0.25,
    "detection_confidence_rationale": "Preserves the frozen realtime_fast detector eligibility floor and applies to the single contested detection shared by both candidates.",
    "minimum_hidden_overlap_similarity": 0.5,
    "minimum_overlap_rationale": "Requires direct geometric owner evidence and prevents appearance-only reservation.",
    "minimum_optional_evidence_count_per_candidate": 1,
    "optional_evidence_set": [
      "appearance_available",
      "motion_available"
    ],
    "optional_evidence_rationale": "Both hidden and visible candidates must have at least one non-geometry evidence channel; absence on either side causes abstention and cannot become positive evidence.",
    "track_freshness_max_detection_opportunities": 5,
    "maximum_hidden_stale_detection_opportunities": 5,
    "hidden_age_rationale": "Freshness decays linearly to zero across five detector opportunities, skipped non-detector frames do not increment it, and older hidden tracks abstain.",
    "requires_selected_visible_competitor": true,
    "tie_behavior": "A hidden-visible quality tie yields score 0.5 and abstains.",
    "threshold_equality_behavior": "An otherwise eligible finite score exactly equal to 0.60 activates.",
    "numeric_comparison_tolerance": 1e-12,
    "abstention_behavior": [
      "score_below_threshold",
      "missing_or_invalid_mandatory_geometry",
      "missing_or_nonfinite_detection_confidence",
      "detection_confidence_below_0.25",
      "hidden_overlap_similarity_below_0.50",
      "either_candidate_has_no_optional_evidence",
      "hidden_staleness_above_five_detection_opportunities",
      "no_selected_visible_competitor",
      "any_nonfinite_feature_or_quality"
    ]
  },
  "selection_objective": {
