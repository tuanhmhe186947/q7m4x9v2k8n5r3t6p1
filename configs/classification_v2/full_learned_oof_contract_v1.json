  "forbidden_model_inputs": [
    "manual_*",
    "review_*",
    "behavior_before_review",
    "original_behavior",
    "review_unit_id",
    "window_id",
    "temporal_unit_key",
    "video_key",
    "dataset_id",
    "pig_id",
    "track_id",
    "path_columns",
    "label_columns",
    "split_columns"
  ],
  "required_output_schema": {
    "prediction_schema": "classification_v2_prediction_schema_contract_v1",
    "native_metrics": true,
    "confidence_intervals": true,
    "source_balanced_metrics": true,
    "branch_ablation_deltas": true,
    "shortcut_aware_reporting": true
  },
  "required_record": "outputs/classification_v2/experiment_registry/full_multimodal_oof_record.json",
  "paper_ready_requires_record": true
}
