{
  "version": "classification_v2_q2_final_calibration_paper_package_contract_v1",
  "purpose": "Define the leakage-safe final calibration, model-selection, and paper-package contract for Q2 multimodal classification_v2.",
  "claim_boundary": {
    "target_strength": "Q2_strong",
    "primary_claim": "Improved internal pig behavior recognition under recording-date/video-safe validation.",
    "external_generalization_claim": false,
    "pig_id_identity_scope": "annotation-local only; not identity across videos; never persistent biological identity",
    "prohibited_claims": [
      "external farm generalization",
      "external camera generalization",
      "external cohort generalization",
      "unseen biological pig identity generalization",
      "state-of-the-art claim without external benchmark"
    ]
  },
  "execution_policy": {
    "full_oof_predictions_required_before_final_claim": true,
    "outer_test_used_for_model_selection": false,
    "outer_test_used_for_threshold_tuning": false,
    "outer_test_used_for_calibration_fit": false,
    "calibration_fit_scope": "inner_validation_or_oof_train_folds_only",
    "final_test_is_single_touch": true,
    "requires_explicit_user_authorization_for_full_oof_or_final_test": true
  },
  "model_selection_policy": {
    "selection_unit": "native_temporal_unit",
    "primary_metric": "macro_f1",
    "tie_break_metrics": [
      "balanced_accuracy",
      "multiclass_mcc",
      "negative_log_likelihood",
      "top_label_ece"
    ],
    "minimum_effect_size_of_interest": {
      "macro_f1_absolute_delta": 0.03,
      "balanced_accuracy_absolute_delta": 0.03,
      "per_behavior_macro_f1_floor": 0.15
    },
    "candidate_set_is_predeclared": true,
    "model_family_labels": [
      "B2_spatial_only",
      "B3_actor_image_only",
      "B4_actor_spatial",
      "B5_actor_spatial_partner_context",
      "B6_actor_spatial_partner_multitask",
      "B7_full_candidate_domain_controls"
    ]
  },
  "calibration_policy": {
    "allowed_methods": [
      "temperature_scaling",
      "vector_temperature_scaling",
      "isotonic_regression_per_class_when_data_sufficient"
    ],
    "default_method": "temperature_scaling",
    "fit_inputs": [
      "oof_train_fold_logits",
      "inner_validation_logits"
    ],
    "forbidden_fit_inputs": [
      "outer_test_logits",
      "manual_review_columns",
      "review_reason",
      "identifier_columns",
      "path_columns",
      "label_text_columns_in_X"
    ],
    "required_outputs": {
      "calibration_params_json": "outputs/classification_v2/q2_final_package/calibration_params.json",
      "calibrated_native_predictions_csv": "outputs/classification_v2/q2_final_package/calibrated_native_unit_predictions.csv",
      "calibration_audit_json": "outputs/classification_v2/q2_final_package/calibration_audit.json"
    }
  },
  "required_metric_tables": [
    "pooled_native_unit_metrics",
    "outer_fold_metrics",
    "source_type_slice_metrics",
    "recording_group_slice_metrics",
    "behavior_label_slice_metrics",
    "matched_6_frame_source_class_balanced_metrics",
    "per_class_source_slice_metrics",
    "probability_calibration_metrics",
    "confusion_pair_metrics",
    "ablation_delta_metrics",
    "cluster_bootstrap_confidence_intervals",
    "holm_corrected_pairwise_tests"
  ],
  "required_figures": [
    "macro_f1_ablation_bar_with_ci",
    "per_behavior_f1_heatmap",
    "confusion_matrix_native_units",
    "calibration_reliability_diagram",
    "source_slice_performance_plot",
    "confusion_pair_error_breakdown"
  ],
  "required_package_artifacts": {
    "final_report_md": "outputs/classification_v2/q2_final_package/q2_final_report.md",
    "final_report_json": "outputs/classification_v2/q2_final_package/q2_final_report.json",
    "model_card_md": "outputs/classification_v2/q2_final_package/model_card.md",
    "data_card_md": "outputs/classification_v2/q2_final_package/data_card.md",
    "split_manifest_csv": "outputs/classification_v2/q2_grouped_folds/q2_outer_fold_assignments.csv",
    "feature_whitelist_json": "configs/classification_v2/q2_feature_whitelist_v1.json",
    "training_snapshot_json": "outputs/classification_v2/model_design/training_snapshot_v1.json",
    "native_predictions_csv": "outputs/classification_v2/q2_oof_evaluation/native_unit_predictions.csv",
    "metrics_json": "outputs/classification_v2/q2_oof_evaluation/q2_oof_metrics.json",
    "reproducibility_audit_json": "outputs/classification_v2/q2_final_package/reproducibility_audit.json"
  },
  "required_reproducibility_fields": [
    "git_commit",
    "git_dirty",
    "python_executable",
    "python_version",
    "torch_version",
    "cuda_available",
    "cuda_version",
    "device_name",
    "seed_values",
    "deterministic_flags",
    "data_snapshot_id",
    "feature_whitelist_sha256",
    "split_manifest_sha256",
    "training_config_sha256",
    "prediction_file_sha256"
  ],
  "required_safety_checks": [
    "model_X_excludes_manual_review_audit_identifier_path_and_label_columns",
    "pig_id_annotation_local_not_identity_split_key",
    "recording_date_or_video_group_safe_split",
    "reviewed_rows_equal_enhanced_rows_after_apply",
    "window_validity_respects_review_training_action",
    "native_temporal_unit_is_primary_metric_unit",
    "outer_test_never_used_for_selection_threshold_or_calibration",
    "hard_negative_review_does_not_auto_change_labels"
  ],
  "completion_gate": {
    "can_claim_q2_result": false,
    "reason": "This contract defines the final package requirements only; full OOF/final-test execution still requires explicit user authorization and clean preflight."
  }
}
