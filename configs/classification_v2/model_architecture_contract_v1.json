{
  "version": "classification_v2_model_architecture_contract_v1",
  "claim_boundary": {
    "target_strength": "Q2_strong",
    "primary_claim": "Improved pig behavior recognition under session/video-safe validation.",
    "prohibited_claims": [
      "Q1-style external farm/camera/cohort generalization without an external validation set",
      "unseen-animal identity generalization from annotation-local pig_id",
      "window-level metrics as independent publication sample size"
    ]
  },
  "paper_candidate": false,
  "model_family": "multimodal_spatiotemporal_bbox_roi_social_context",
  "model_modes": [
    "actor_only",
    "actor_temporal",
    "actor_geometry",
    "actor_geometry_motion",
    "actor_geometry_roi",
    "actor_geometry_roi_social",
    "actor_partner_union",
    "full_multimodal",
    "full_multimodal_hierarchy",
    "spatial_only_control"
  ],
  "implemented_model_architecture_version": "multimodal_sequence_factory_v4_multitask_v2",
  "visual_backbone_contract_version": "classification_v2_visual_backbone_v1",
  "visual_backbone_controls": [
    {
      "control_id": "V0",
      "backbone_name": "resnet18",
      "image_size": 160
    },
    {
      "control_id": "V1",
      "backbone_name": "resnet18",
      "image_size": 224
    },
    {
      "control_id": "V2",
      "backbone_name": "resnet34",
      "image_size": 224
    }
  ],
  "implemented_modules": {
    "model_factory": "src/pig_behavior/classification_v2/models/model_factory.py",
    "temporal_encoders": "src/pig_behavior/classification_v2/models/temporal_encoders.py",
    "temporal_view_loader": "src/pig_behavior/classification_v2/training/temporal_view_loader.py",
    "fusion_model": "src/pig_behavior/classification_v2/models/multimodal_fusion.py",
    "smoke_trainer": "src/pig_behavior/classification_v2/training/multimodal_smoke.py",
    "interaction_context_loader": "src/pig_behavior/classification_v2/datasets/interaction_context_loader.py",
    "visual_interaction_cache": "src/pig_behavior/classification_v2/datasets/visual_interaction_context.py",
    "visual_interaction_loader": "src/pig_behavior/classification_v2/datasets/visual_interaction_loader.py",
    "visual_interaction_cache_builder": "scripts/classification_v2/03_image_cache_context/classification_v2_build_visual_interaction_cache.py",
    "visual_interaction_cache_checker": "scripts/classification_v2/03_image_cache_context/check_classification_v2_visual_interaction_cache.py",
    "visual_interaction_forward_checker": "scripts/classification_v2/03_image_cache_context/check_classification_v2_visual_interaction_forward.py",
    "multitask_fusion": "src/pig_behavior/classification_v2/models/multitask_fusion.py",
    "multitask_loss": "src/pig_behavior/classification_v2/training/multitask_loss.py",
    "multitask_forward_checker": "scripts/classification_v2/04_baselines_smokes/check_classification_v2_multitask_forward.py",
    "multitask_loss_checker": "scripts/classification_v2/04_baselines_smokes/check_classification_v2_multitask_loss.py",
    "multitask_smoke_trainer": "src/pig_behavior/classification_v2/training/multitask_smoke.py",
    "multitask_smoke_checker": "scripts/classification_v2/04_baselines_smokes/check_classification_v2_multitask_smoke_train.py",
    "forward_checker": "scripts/classification_v2/04_baselines_smokes/check_classification_v2_multimodal_forward.py",
    "model_factory_checker": "scripts/classification_v2/04_baselines_smokes/check_classification_v2_model_factory.py",
    "temporal_view_loader_checker": "scripts/classification_v2/04_baselines_smokes/check_classification_v2_temporal_view_loader.py",
    "smoke_train_checker": "scripts/classification_v2/04_baselines_smokes/check_classification_v2_multimodal_smoke_train.py",
    "interaction_context_loader_checker": "scripts/classification_v2/03_image_cache_context/check_classification_v2_interaction_context_loader.py",
    "ablation_shortcut_contract_checker": "scripts/classification_v2/07_postrun_evaluation/check_classification_v2_ablation_shortcut_contract.py",
    "prediction_schema_checker": "scripts/classification_v2/06_full_oof_training/check_classification_v2_prediction_schema.py"
  },
  "input_branches": [
    {
      "name": "actor_image_sequence",
      "status": "implemented_smoke_and_resnet_interface",
      "tensor_role": "model_input",
      "source_artifacts": [
        "outputs/classification_v2/train_ready_windows/image_frame_context_manifest.csv",
        "outputs/classification_v2/train_ready_windows/image_window_context_manifest.csv"
      ],
      "mask_artifacts": [
        "image_length_mask",
        "image_observed_mask",
        "image_available_mask",
        "image_quality_mask"
      ],
      "allowed_context": "actor bbox crop sequence only",
      "paper_candidate_required": true
    },
    {
      "name": "spatial_sequence_bbox_motion_roi_social_quality",
      "status": "implemented_smoke",
      "tensor_role": "model_input",
      "source_artifacts": [
        "outputs/classification_v2/train_ready_windows/X_spatial_sequences.npz"
      ],
      "mask_artifacts": [
        "spatial_length_mask",
        "spatial_observed_mask",
        "spatial_available_mask",
        "spatial_quality_mask"
      ],
      "required_feature_groups": [
        "bbox_xywh_n",
        "bbox_shape_n",
        "motion_delta",
        "roi_class_relation",
        "social_relation",
        "quality_mask"
      ],
      "allowed_context": "whitelisted bbox, motion, ROI relation, social relation, and quality numeric tensors",
      "paper_candidate_required": true
    },
    {
      "name": "label_independent_partner_context",
      "status": "implemented_smoke",
      "tensor_role": "model_input",
      "source_artifacts": [
        "outputs/classification_v2/train_ready_windows/interaction_window_context_manifest.csv"
      ],
      "mask_artifacts": [
        "interaction_context_available_mask",
        "interaction_context_quality_mask"
      ],
      "allowed_context": "label-independent nearest-partner numeric relations with top-K-compatible masking",
      "paper_candidate_required": true
    },
    {
      "name": "actor_partner_union_context",
      "status": "implemented_smoke",
      "tensor_role": "model_input",
      "source_artifacts": [
        "outputs/classification_v2/train_ready_windows/interaction_window_context_manifest.csv",
        "outputs/classification_v2/visual_interaction_cache/visual_context_manifest.csv",
        "outputs/classification_v2/visual_interaction_cache/packed_rgb_64_letterbox.npy",
        "outputs/classification_v2/visual_interaction_cache/packed_image_cache_index.csv",
        "outputs/classification_v2/visual_interaction_cache/packed_image_cache_audit.json"
      ],
      "mask_artifacts": [
        "visual_context_length_mask",
        "visual_context_observed_mask",
        "visual_context_available_mask",
        "visual_context_quality_mask"
      ],
      "allowed_context": "actor-nearest-partner union crop selected from same-frame audited geometry; legacy crop-only rows remain masked unavailable",
      "paper_candidate_required": true
    },
    {
      "name": "social_graph_context",
      "status": "planned_exploratory",
      "tensor_role": "optional_model_input",
      "source_artifacts": [
        "outputs/classification_v2/train_ready_windows/social_graph_window_tensors.npz"
      ],
      "mask_artifacts": [
        "social_graph_available_mask"
      ],
      "allowed_context": "same-frame pig graph derived from bbox geometry and audited social features",
      "paper_candidate_required": false
    }
  ],
  "fusion_policy": {
    "type": "late_fusion_with_masks",
    "required_controls": [
      "branch-specific masks",
      "branch ablation",
      "source-domain balance audit",
      "shortcut controls before paper claim"
    ],
    "forbidden_inputs": [
      "manual_*",
      "review_*",
      "*behavior*",
      "*label*",
      "original_behavior",
      "review_unit_id",
      "window_id",
      "temporal_unit_key",
      "video_key",
      "dataset_id",
      "pig_id",
      "track_id",
      "object_track_key",
      "source_type",
      "source_*",
      "split",
      "split_*",
      "*_path"
    ]
  },
  "evaluation_contract": {
    "split_policy": "recording_group_oof",
    "metric_unit": "native_temporal_unit",
    "prediction_schema_contract": "classification_v2_prediction_schema_contract_v1",
    "primary_metrics": [
      "macro_f1_supported",
      "macro_recall_supported",
      "accuracy"
    ],
    "uncertainty": "oof_fold_cluster_bootstrap_ci over native temporal-unit predictions",
    "minimum_effect_size_metric": "macro_f1_supported",
    "minimum_effect_size": 0.02
  },
  "paper_candidate_blockers": [
    "full out-of-fold learned model evaluation has not been run yet",
    "branch ablation and shortcut controls must be recorded before paper-facing claim"
  ]
}
