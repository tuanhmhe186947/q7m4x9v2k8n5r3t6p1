{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pig.agent-governance-live-trace.v2",
  "title": "Agent governance live trace",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "trace_kind",
    "campaign_id",
    "run_id",
    "task_id",
    "agent",
    "workspace",
    "events",
    "artifacts"
  ],
  "properties": {
    "schema_version": {"const": "pig.agent-governance-live-trace.v2"},
    "trace_kind": {"const": "live_agent_trace"},
    "campaign_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "pattern": "^AR-[0-9]{3}$"},
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model", "session_id"],
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "session_id": {"type": "string", "minLength": 1}
      }
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo_root", "start_head", "target_ref"],
      "properties": {
        "repo_root": {"type": "string", "minLength": 1},
        "start_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "target_ref": {"type": "string", "minLength": 1}
      }
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["seq", "type", "timestamp", "prev_hash", "payload", "event_hash"],
        "properties": {
          "seq": {"type": "integer", "minimum": 1},
          "type": {"type": "string", "minLength": 1},
          "timestamp": {"type": "string", "format": "date-time"},
          "prev_hash": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
          "payload": {"type": "object"},
          "event_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "exists"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "exists": {"const": true}
        }
      }
    }
  }
}
