# ==========================================
# 4. Data, Datasets and Annotations (AI Science standards)
# ==========================================
# Ignore large binary/data extensions
*.mp4
*.avi
*.mov
*.mkv
*.zip
*.tar.gz
*.tgz
*.rar
*.7z
*.csv
*.tsv
*.xlsx
*.xml

# Ignore all datasets inside data/ except specific configs/schemas
data/raw/
data/videos/
data/processed/
data/data/
# Keep directory structures and readme documentation
!data/README.md
!data/raw/README.md
!data/videos/README.md
!data/processed/README.md
!data/annotations/README.md

# Ignore specific annotation files (allow schemas/configurations)
data/annotations/tracking/
data/annotations/classification/
data/annotations/scene/background.png

# Keep small config/schema annotations
!data/annotations/roi/ROI_annotations.coco.json
!data/annotations/schemas/cvat_pig_8_labels.json
!data/annotations/scene/mask.png
!data/task.json

# ==========================================
# 5. Model weights & Checkpoints
# ==========================================
*.pt
*.pth
*.onnx
*.tflite
*.keras
*.h5
*.pb
*.engine
*.ckpt
*.weights
*.pkl
*.joblib
models/
!models/README.md
!models/behavior/README.md
!models/detector/README.md

# ==========================================
# 6. Runtime Outputs, Logs & Experiments
# ==========================================
configs/tracking_paths_experiment_local.json
outputs/
.agents/authorizations/
.agents/runtime/
human_review_workspace/
logs/
checkpoints/
runs/
wandb/
.mlflow/
lightning_logs/
artifacts/*
!artifacts/manifest.yaml

# ==========================================
# 7. Local environments / Secrets
# ==========================================
.env
.env.*
secrets.yaml
credentials.json

# Local runtime credentials and server configuration
config/secret_key
config/hypercorn.toml

# Git-managed temporary worktrees are not project source content
.codex_worktrees/
